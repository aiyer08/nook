# Optional. Both of these are public identifiers, not secrets — they end up in
# the browser bundle by design. Copy this file to .env to use them locally.

# Shown in the calendar-sync setup steps as an origin to authorise in Google
# Cloud, alongside http://localhost:5173. Set it to wherever you deploy.
VITE_PUBLIC_ORIGIN=https://your-app.vercel.app

# Pre-fills the Google OAuth client ID. Leave it out and you can just paste the
# ID into Settings › Calendars instead, which avoids a rebuild to change it.
# VITE_GOOGLE_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com
